{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "מאגר שאלות לתרגול",
  "type": "object",
  "required": ["version", "questions"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string" },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "options", "correctIndex", "solution"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "prompt": { "type": "string" },
          "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
          "correctIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
          "solution": { "type": "string" },
          "source": { "type": "string" },
          "difficulty": { "type": "integer", "enum": [1, 2, 3] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$comment": "נדרשת גם בדיקה שמזהי השאלות ייחודיים, שאין שתי נקודות רצופות במזהה, ושאינדקס התשובה קטן ממספר האפשרויות. היישום בודק תנאים אלה."
}
